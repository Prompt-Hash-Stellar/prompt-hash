# PromptHash auxiliary server (Express + MongoDB)
# Copy to server/.env when running the backend locally.

# Required for server features (draft lifecycle, buyer collections, chat)
MONGODB_URI=mongodb://127.0.0.1:27017/prompt-hash-stellar

# Optional — email notifications
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Required for GET /api/prompts/reports (report-review authorization).
# HMAC-SHA256 signing secret for report-review tokens. Must be >= 32 chars.
# Generate: openssl rand -base64 32 | tr -d '=' | tr '+/' '-_'
# REPORT_REVIEW_SECRET=

# Optional — comma-separated token ids (jti) to force-revoke.
# REPORT_REVIEW_REVOKED_JTIS=

# Optional — S3 backup (see docs/operations/backup-and-recovery.md)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
